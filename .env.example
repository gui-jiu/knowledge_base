# ====================
# Model Source & Cache
# ====================
# 模型来源（ModelScope / HuggingFace）
MINERU_MODEL_SOURCE=modelscope
# ModelScope 离线模式（1=启用）
MODELSCOPE_OFFLINE=1
# ModelScope 模型缓存路径
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
# Hugging Face 缓存路径
HF_HOME=D:/ai_models/huggingface_cache
# 临时文件根目录
MD_ROOT_DIR=./temp-files/

# ====================
# LLM API
# ====================
# API 密钥
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API 基础地址（DeepSeek，OpenAI 兼容格式）
OPENAI_API_BASE=https://api.deepseek.com
# 默认 LLM 模型
LLM_DEFAULT_MODEL=deepseek-chat
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型（预留，后续接入替代API）
VL_MODEL=

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=D:\ai_models\modelscope_cache\models\BAAI\bge-m3
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备（无NVIDIA显卡时改为 cpu）
BGE_DEVICE=cpu
# 是否使用半精度（True/False）
BGE_FP16=False
# BGE 重排序模型路径
BGE_RERANKER_LARGE=D:\ai_models\modelscope_cache\models\BAAI\bge-reranker-large
# 重排序模型设备
BGE_RERANKER_DEVICE=cpu
# 重排序模型半精度
BGE_RERANKER_FP16=0

# ====================
# Embedding General
# ====================
# 嵌入向量维度（BGE-M3 稠密向量）
EMBEDDING_DIM=1024
# 嵌入模型名称
EMBEDDING_MODEL=BAAI/bge-m3

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址（替换为实际IP）
MILVUS_URL=http://<服务器IP>:19530
# 知识库切片集合名
CHUNKS_COLLECTION=kb_chunks
# 商品名称集合名
ITEM_NAME_COLLECTION=kb_item_names
# 相似度度量方式
MILVUS_METRIC_TYPE=COSINE
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# Document Database (MongoDB)
# ====================
# MongoDB 连接 URL（带认证，用户名/密码/地址请替换为实际值）
MONGO_URL=mongodb://<用户名>:<密码>@<服务器IP>:27017
# 数据库名
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点（替换为实际IP）
MINIO_ENDPOINT=<服务器IP>:9000
# 访问密钥（替换为实际值）
MINIO_ACCESS_KEY=<MinIO用户名>
# 私有密钥（替换为实际值）
MINIO_SECRET_KEY=<MinIO密码>
# 存储桶名称
MINIO_BUCKET_NAME=knowledge-base

# ====================
# Other / MCP Services（预留，后续接入替代联网搜索API）
# ====================
# MCP Web 搜索服务地址
MCP_DASHSCOPE_BASE_URL=
